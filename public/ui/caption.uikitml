<!--
  Caption card beyond the paper's far edge, tilted toward the writer.
  Every instruction and result appears here, so the app works without sound.
-->
<style>
  .root { flex-direction: column; width: 440px; }
  .content { flex-direction: column; gap: 6px; padding-left: 22px; padding-right: 22px; padding-top: 16px; padding-bottom: 16px; }
  .eyebrow { color: #a3361f; font-size: 14px; font-weight: 700; letter-spacing: 1.4px; }
  .eyebrow:dark { color: #ff8a65; }
  .title { color: #1c1d20; font-size: 27px; font-weight: 700; line-height: 33px; }
  .title:dark { color: #fafaf7; }
  .body { color: #3a3b40; font-size: 19px; line-height: 25px; }
  .body:dark { color: #dddfe3; }
  .score { color: #8a5a00; font-size: 19px; font-weight: 700; }
  .score:dark { color: #f2bf4a; }
  .row { flex-direction: row; gap: 8px; padding-left: 22px; padding-right: 22px; padding-bottom: 16px; }
</style>
<Panel class="root">
  <div class="content">
    <div id="cap-eyebrow" class="eyebrow">HANDS OF A MASTER</div>
    <div id="cap-title" class="title">Finding your desk</div>
    <div id="cap-body" class="body">Sit comfortably. Good light helps the headset see your hands.</div>
    <div id="cap-score" class="score"> </div>
  </div>
  <div id="cap-actions" class="row" style="display: none">
    <Button id="btn-next"><ButtonLabel>Next lesson</ButtonLabel></Button>
    <Button id="btn-again"><ButtonLabel>Write it again</ButtonLabel></Button>
  </div>
</Panel>

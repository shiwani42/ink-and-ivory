<!--
  2D landing panel, shown in the browser before entering mixed reality.
  Plain ASCII copy only (the panel font has no CJK glyphs).
-->
<style>
  .root { flex-direction: column; width: 440px; }
  .content { flex-direction: column; gap: 8px; padding-left: 26px; padding-right: 26px; padding-top: 24px; padding-bottom: 10px; }
  .eyebrow { color: #a3361f; font-size: 14px; font-weight: 700; letter-spacing: 1.6px; }
  .eyebrow:dark { color: #ff8a65; }
  .heading { color: #1c1d20; font-size: 34px; font-weight: 700; line-height: 40px; }
  .heading:dark { color: #fafaf7; }
  .body { color: #3a3b40; font-size: 19px; line-height: 26px; }
  .body:dark { color: #dddfe3; }
  .small { color: #6a6b70; font-size: 13px; line-height: 18px; }
  .small:dark { color: #9a9ca3; }
  .button { justify-content: flex-start; margin-left: 26px; margin-right: 26px; margin-bottom: 12px; }
  .foot { padding-left: 26px; padding-right: 26px; padding-bottom: 22px; }
</style>
<Panel class="root">
  <div class="content">
    <div class="eyebrow">MIXED REALITY CALLIGRAPHY</div>
    <div class="heading">Hands of a Master</div>
    <div class="body">A master's hands appear over your own, on your real desk.</div>
    <div class="body">Follow them stroke by stroke. As you improve, the master lets go.</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel>Start at my desk</ButtonLabel>
  </Button>
  <div class="foot">
    <div id="xr-note" class="small">Sit at a desk or table in good light. Hands only: no controllers needed.</div>
  </div>
</Panel>
